#!/bin/bash
# mbpfan-apply — apply mbpfan fan-control thresholds as root (via pkexec).
#
# This helper is installed ONCE to a root-owned, non-user-writable path
# (default: /usr/local/libexec/mbpfan-apply) and is invoked by the omarchy
# mbpfan panel via pkexec at that fixed path. pkexec never executes anything
# from the user-writable plugin checkout.
#
# Security posture: the ONLY inputs are the four arguments below, which are
# strictly validated as digit-only integers with ordered ranges. The helper
# reads and writes only the root-owned /etc/mbpfan.conf and restarts the
# root-owned mbpfan service. No user-controlled file path, file content, or
# code is ever on the privileged side, so there is no replace-the-file or
# symlink TOCTOU surface.
#
# Args: LOW HIGH MAX POLL
#   e.g. mbpfan-apply 63 66 86 1
# Exits non-zero on bad input; validates before touching the config.

conf=/etc/mbpfan.conf
low="$1"; high="$2"; max="$3"; poll="$4"

fail() { echo "$1" >&2; exit 1; }

# --- must actually be root (pkexec guarantees this; double-check anyway) ---
[ "$(id -u)" -eq 0 ] || fail "must be run as root (via pkexec)"

# --- validate: digits only (no shell metacharacters can reach this script) ---
for v in "$low" "$high" "$max" "$poll"; do
  [[ "$v" =~ ^[0-9]+$ ]] || fail "invalid number: '$v'"
done

# --- validate: ordered ranges (same rules mbpfan itself enforces) ---
[ "$low" -lt "$high" ] || fail "low_temp must be < high_temp"
[ "$high" -lt "$max" ] || fail "high_temp must be < max_temp"
[ "$poll" -ge 1 ] || fail "polling_interval must be >= 1"

# --- config must exist (root-owned; not subject to user tampering) ---
[ -f "$conf" ] || fail "config not found: $conf"

# --- update keys, preserving everything else ---
for kv in "low_temp=$low" "high_temp=$high" "max_temp=$max" "polling_interval=$poll"; do
  key="${kv%%=*}"; val="${kv#*=}"
  if grep -qE "^\s*${key}\s*=" "$conf"; then
    sed -ri "s/^(\s*${key}\s*=\s*).*/\1${val}/" "$conf"
  else
    sed -i "/^\[general\]/a ${key} = ${val}" "$conf"
  fi
done

# --- apply: reload the service so the new thresholds take effect ---
/usr/bin/systemctl restart mbpfan || fail "failed to restart mbpfan"
echo "applied: low=$low high=$high max=$max poll=$poll"
