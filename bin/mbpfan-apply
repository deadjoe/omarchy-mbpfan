#!/bin/bash
# mbpfan-apply — render a candidate /etc/mbpfan.conf in the user session.
#
# UNPRIVILEGED helper. Given LOW HIGH MAX POLL and an output path, it reads the
# current /etc/mbpfan.conf, replaces the four fan-control keys (low_temp,
# high_temp, max_temp, polling_interval), and writes the result to TMPFILE. It
# NEVER runs as root and never restarts mbpfan. The omarchy panel elevates only
# fixed, trusted system binaries afterwards:
#   pkexec install        -> write the rendered file to /etc/mbpfan.conf
#   pkexec systemctl      -> restart mbpfan so the new thresholds apply
# This keeps all privileged code on system binaries (with strictly validated
# values) instead of elevating user-writable plugin scripts.
#
# Args: LOW HIGH MAX POLL TMPFILE
#   e.g. mbpfan-apply 63 66 86 1 /run/user/1000/omarchy-mbpfan/mbpfan.conf.tmp
# Exits non-zero on bad input. Validates ranges before touching anything.

conf=/etc/mbpfan.conf
low="$1"; high="$2"; max="$3"; poll="$4"; out="$5"

fail() { echo "$1" >&2; exit 1; }

# --- validate: non-negative integers, ordered ---
for v in "$low" "$high" "$max" "$poll"; do
  [[ "$v" =~ ^[0-9]+$ ]] || fail "invalid number: '$v'"
done
[ "$low" -lt "$high" ] || fail "low_temp must be < high_temp"
[ "$high" -lt "$max" ] || fail "high_temp must be < max_temp"
[ "$poll" -ge 1 ] || fail "polling_interval must be >= 1"

# --- inputs ---
[ -f "$conf" ] || fail "config not found: $conf"
[ -n "$out" ] || fail "no output path"

# --- write to an owner-only temp file, preserving everything else ---
umask 077
mkdir -p "$(dirname "$out")" || fail "cannot create output dir: $(dirname "$out")"
cp "$conf" "$out" || fail "cannot copy config to: $out"

# --- replace the four keys (same logic as the old in-place apply) ---
for kv in "low_temp=$low" "high_temp=$high" "max_temp=$max" "polling_interval=$poll"; do
  key="${kv%%=*}"; val="${kv#*=}"
  if grep -qE "^\s*${key}\s*=" "$out"; then
    sed -ri "s/^(\s*${key}\s*=\s*).*/\1${val}/" "$out"
  else
    sed -i "/^\[general\]/a ${key} = ${val}" "$out"
  fi
done

echo "rendered $out"
